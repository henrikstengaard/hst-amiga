<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Hst Amiga is a library for reading and writing Amiga partition table, file systems, data types.</Description>
    <PackageTags>Hst;Amiga;RDB;FFS;PFS3;SFS;UAEFSDB</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: missing XML comment for publicly visible type or member -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="readme.md" Pack="true" PackagePath="\" />
    <None Include="..\..\license.txt" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Hst.Amiga.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Hst.Core" Version="1.0.101-prerelease" />
    <PackageReference Include="Hst.Imaging" Version="1.0.101-prerelease" />
    <PackageReference Include="Hst.Imaging.Pngcs" Version="1.0.101-prerelease" />
  </ItemGroup>
</Project>
