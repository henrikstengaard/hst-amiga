<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <AssemblyAttribute Include="Hst.Amiga.ConsoleApp.BuildDateAttribute">
            <_Parameter1>$([System.DateTime]::UtcNow.ToString("yyyyMMddHHmmss"))</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>
    
    <ItemGroup>
      <PackageReference Include="Hst.Core" Version="0.4.96" />
      <PackageReference Include="Hst.Imaging.Pngcs" Version="0.4.96" />
      <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
      <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
      <PackageReference Include="Serilog" Version="4.4.0" />
      <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
      <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
      <PackageReference Include="System.CommandLine" Version="2.0.13" />
    </ItemGroup>
    
    <ItemGroup>
      <ProjectReference Include="..\Hst.Amiga\Hst.Amiga.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\license.txt">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>
    
    <ItemGroup>
      <None Update="palettes\amigaos-1.3-palette.json">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="palettes\amigaos-3.1-palette.json">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="palettes\amigaos-full-palette.json">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="palettes\amigaos-full-palette.gpl">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="palettes\amigaos-1.3-palette.gpl">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="palettes\amigaos-3.1-palette.gpl">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
    </ItemGroup>
    
</Project>
